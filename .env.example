OPENROUTER_API_KEY=
PROXY_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=OpenRouter Vercel Proxy
OPENROUTER_SITE_URL=http://localhost:3000
DEFAULT_MODEL=openai/gpt-4o-mini

DENY_ORIGINS=
DENY_HOSTS=
DENY_LOCALHOST=false
VERCEL_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_GATEWAY_DEFAULT_MODEL=openai/gpt-4o-mini

VERCEL_GATEWAY_APP_NAME=Your Proxy Name
VERCEL_GATEWAY_SITE_URL=http://localhost:3000

# Gemini canonical bridge (new Base URL: /api/gemini/v1)
# The dedicated values take precedence; PROXY_API_KEY is reused if
# GEMINI_PROXY_API_KEY is empty.
GEMINI_AI_GATEWAY_API_KEY=SAME_AS_VERCEL_AI_GATEWAY_KEY
GEMINI_PROXY_API_KEY=SAME_AS_VERCEL_AI_GATEWAY_KEY
GEMINI_DEFAULT_MODEL=google/gemini-3.7-flash
# Optional AI SDK Gateway v4 endpoint override. Usually leave empty.
GEMINI_GATEWAY_BASE_URL=

# Required for durable multi-instance/serverless Gemini sessions in production.
# Vercel KV and Upstash's standard aliases are also detected automatically.
GEMINI_REDIS_REST_URL=
GEMINI_REDIS_REST_TOKEN=
GEMINI_STATE_TTL_SECONDS=604800
GEMINI_LOCK_TTL_SECONDS=300
GEMINI_LOCK_WAIT_MS=15000
# Local fallback only. Vercel without Redis falls back to ephemeral /tmp state.
GEMINI_STATE_DIR=.gemini-canonical-state
# Vercel disables local apply_patch preflight by default because it cannot see
# the Codex client's workspace. Only enable on a trusted same-machine server.
GEMINI_ENABLE_LOCAL_PATCH_PREFLIGHT=false
